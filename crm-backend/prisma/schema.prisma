generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  MASTER_ADMIN
  MASTER_SUPPORT
  MASTER_FINANCE
  MASTER_ANALYTICS
  TENANT_ADMIN
  TENANT_USER
}

enum CompanyType {
  PF
  PJ
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PaymentMethod {
  CARD
  PIX
  BOLETO
  TRANSFER
  OTHER
}

enum PaymentStatus {
  PAID
  OPEN
  FAILED
  CANCELED
  REFUNDED
  CHARGEBACK
}

enum CustomEntityType {
  company
  employee
}

enum CustomFieldType {
  text
  date
  select
  money
  number
  boolean
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users                   User[]
  companies               Company[]
  auditLogs               AuditLog[]
  customFieldDefinitions  CustomFieldDefinition[]
  tableViews              TableView[]
  adminSettings           AdminSettings?
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  name         String
  passwordHash String
  status       String   @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles  UserRole[]
  audit  AuditLog[] @relation("actor")
  criticalSessions CriticalEditSession[]
  tableViews TableView[]
}

model UserRole {
  userId String
  role   RoleName
  tenantId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([tenantId, role])
}

model Company {
  id              String        @id @default(uuid())
  tenantId        String
  name            String
  cpfCnpj         String
  type            CompanyType
  plan            String
  status          CompanyStatus @default(ACTIVE)
  currentRevenue  Int           @default(0) // cents
  paymentMethod   PaymentMethod @default(CARD)
  paymentStatus   PaymentStatus @default(OPEN)
  cycle           String        @default("MONTHLY")
  segment         String?
  acquiredAt      DateTime?
  email           String?
  phone           String?
  internalNotes   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices BillingInvoice[]
  tickets  SupportTicket[]
}

model BillingInvoice {
  id         String        @id @default(uuid())
  tenantId   String
  companyId  String
  amount     Int           // cents
  currency   String        @default("BRL")
  cycle      String
  status     PaymentStatus @default(OPEN)
  dueDate    DateTime
  paidAt     DateTime?
  gatewayId  String?
  createdAt  DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  payments BillingPayment[]

  @@index([tenantId, companyId, dueDate])
}

model BillingPayment {
  id         String        @id @default(uuid())
  tenantId   String
  invoiceId  String
  amount     Int
  method     PaymentMethod
  status     PaymentStatus
  gatewayChargeId String?
  attemptedAt DateTime @default(now())
  paidAt     DateTime?
  
  // LGPD-safe payment metadata
  cardLast4              String?  @db.VarChar(4)
  cardBrand              String?  @db.VarChar(50)
  cardHolderName         String?  @db.VarChar(200)
  providerPaymentMethodId String? @db.VarChar(255)
  providerChargeId       String?  @db.VarChar(255)
  providerTransactionId  String?  @db.VarChar(255)
  authorizationCode      String?  @db.VarChar(100)

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
}

model BillingEvent {
  id        String   @id @default(uuid())
  tenantId  String
  eventId   String   @unique
  type      String
  payload   Json
  signatureHash String?
  receivedAt DateTime @default(now())

  @@index([tenantId, receivedAt])
  @@index([tenantId, signatureHash, receivedAt])
}

model SupportTicket {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  subject   String
  status    String   @default("OPEN")
  slaDueAt  DateTime?
  lastInteractionAt DateTime?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId, createdAt])
}

model CriticalEditSession {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  entityType String
  entityId   String
  field      String
  oldValue   Json?
  newValue   Json?
  action     String
  actorId    String?
  actorRole  String?
  origin     String   @default("system")
  requestId  String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("actor", fields: [actorId], references: [id])

  @@index([tenantId, entityType, entityId, createdAt])
}

model CustomFieldDefinition {
  id        String              @id @default(uuid())
  tenantId  String
  entityType CustomEntityType
  key       String
  label     String
  type      CustomFieldType
  options   Json?
  position  Int                 @default(0)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([tenantId, entityType, key])
  @@index([tenantId, entityType, position])
}

model CustomFieldValue {
  id         String @id @default(uuid())
  tenantId   String
  entityType CustomEntityType
  entityId   String
  fieldId    String
  value      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, entityId, fieldId])
  @@index([tenantId, entityType, entityId])
}

model TableView {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  entityType String
  name       String
  config     Json
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, entityType, name])
  @@index([tenantId, userId, entityType, isDefault])
}

model AdminSettings {
  tenantId        String @id
  brandName       String?
  logo            String?
  loginBackground String?
  theme           Json?
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
